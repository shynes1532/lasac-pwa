# ============================================================
# Radar de Mercado (/api/radar) — variables de entorno
# Cargalas en Vercel: Project → Settings → Environment Variables.
# NUNCA las commitees con valores reales.
# ============================================================

# Key del AI Gateway de Vercel (vercel.com/ai-gateway → API Keys).
# Con esto alcanza: la búsqueda web de Exa se enruta por el Gateway,
# no hace falta una API key propia de Exa.
AI_GATEWAY_API_KEY=

# Código interno que pide la pantalla #radar antes de dejar buscar.
# Elegí algo largo y compartilo solo con el equipo comercial.
# Si esta variable está vacía, el endpoint devuelve 503 y no busca nada.
RADAR_ACCESS_CODE=

# Opcional — modelo del Gateway que arma el informe.
# Default: anthropic/claude-opus-5
RADAR_MODEL=

# Opcional — tope de búsquedas por día (protege el presupuesto).
# Default: 120
RADAR_MAX_DIA=
